# Copy this file to .env.local for local development, and add the same
# variables in Vercel → Project → Settings → Environment Variables.
#
# Spotify search for the site-wide music player (src/app/api/spotify/search).
# Create an app at https://developer.spotify.com/dashboard and copy its keys.
# Without these the player still plays its default track; only search is off.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
